# Variables de entorno para VULCANIA
# Copia este archivo como .env.local y completa con tus credenciales reales

# SUPABASE - OPCIONALES (solo si NO usas modo demo offline)
NEXT_PUBLIC_SUPABASE_URL="tu_supabase_url_aqui"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu_anon_key_aqui"

# SUPABASE - OPCIONALES AVANZADAS
SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_aqui"
SUPABASE_JWT_SECRET="tu_jwt_secret_aqui"

# MODO DEMO (sin Supabase)
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_DEMO_READONLY="true"
NEXT_PUBLIC_DEMO_PHONE="+56 9 8765 4321"
NEXT_PUBLIC_ENABLE_ADMIN_PANEL="false"

# Instrucciones:
# 1. Si usarás demo offline, no necesitas configurar Supabase.
# 2. Si usarás modo completo, agrega las variables de Supabase.
# 3. Guarda como .env.local

# Para Vercel:
# Agrega estas mismas variables en tu proyecto Vercel
# Dashboard → Settings → Environment Variables
